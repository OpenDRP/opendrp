# ==============================================================================
# OpenDRP environment configuration
# ==============================================================================
# Fastest path: let the wizard write this file for you. It generates every secret
# below with a cryptographic RNG instead of leaving you to invent five of them.
#
#     python setup.py           # asks a few deployment and security questions, writes .env
#     python setup.py --check   # audits an existing .env against this template
#
# It needs Python 3.8 or newer and *nothing else*: the standard library only, no
# `pip install`, no `cryptography`, no network access. Without a host Python, the
# same script runs in a container — from the checkout:
#
#     docker run --rm -it -v "$PWD":/work -w /work python:3.12-alpine python setup.py
#
# Filling it in by hand works too. These five values have no safe default, and are
# the only ones you have to generate yourself:
#
#     POSTGRES_PASSWORD   REDIS_PASSWORD   JWT_SECRET_KEY
#     ENCRYPTION_KEY      AUDIT_CHAIN_KEYS
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"     # passwords
#     python -c "import secrets; print(secrets.token_urlsafe(48))"     # JWT, audit chain
#     python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# The last one is a valid Fernet key built from the standard library, which is why
# no package is needed here either. With `cryptography` available,
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# produces the same shape.
#
# Everything else has a working default. The values Compose builds for you are
# listed at the end, together with the optional overrides most deployments never
# touch.
#
# Never commit .env. Production startup rejects the placeholders below, and so
# does `python setup.py --check`.
# ==============================================================================

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=opendrp
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=opendrp
POSTGRES_PORT=127.0.0.1:5432

# --- Redis ---------------------------------------------------------------------
# Redis is the Celery broker, not just a cache: whatever reaches it can read
# other connectors' task payloads, push a task the worker executes with the
# platform's own database credentials, and clear the rate-limit counters. So the
# password is required — compose refuses to start without it, the Redis service
# starts with --requirepass, and a production startup rejects a REDIS_URL that
# does not carry it.
#
# Keep the value URL-safe: Compose interpolates it into `redis://:<password>@redis`
# and into the PostgreSQL URL, so a character that needs percent-encoding (`@`,
# `:`, `/`, `#`) produces a malformed connection URL instead of a clear error.
# `secrets.token_urlsafe` and `python setup.py` both satisfy this.
REDIS_PASSWORD=REPLACE_WITH_A_GENERATED_REDIS_PASSWORD
REDIS_PORT=127.0.0.1:6379

# --- Application ---------------------------------------------------------------
# The one shape this project supports. In development the application skips the
# checks that protect a real installation (a pinned image version, explicit
# secrets, a Secure refresh cookie, an explicit proxy allowlist), so a file with
# anything else here is not an installation of this platform.
APP_ENV=production
# The release to run: the image tag these Compose files build or pull, and the
# version the UI reports. Required — `latest` is a moving target, and "the same
# version" stops being a statement anyone can check (docs/upgrading.md).
#
# Keep it equal to `backend/app/__init__.py`: `make up` builds these images from
# this checkout, `/api/v1/health` reports the running code's version and Settings
# reports this one, so a file that disagrees has the installation displaying two
# versions. `python setup.py` offers the checkout's version, and `--check`
# reports the difference as a note. A deliberate difference is `make pull-prod`.
OPENDRP_VERSION=0.2.1
# Minimum level for platform log records (CRITICAL, ERROR, WARNING, INFO, DEBUG).
# It cannot silence the audit trail: opendrp.audit is pinned at INFO so that no
# log-level setting can stop the platform recording who deleted an asset.
LOG_LEVEL=INFO
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=3
# Always true here. The refresh cookie is the session of record, and a browser
# only sends a Secure cookie over HTTPS — the exception is `localhost`, which
# every browser treats as trustworthy, so an installation checked at
# http://localhost:<port> still signs in. Setting this false removes that
# protection for every real user, and the application refuses it outright when
# APP_ENV is production.
AUTH_COOKIE_SECURE=true
# Bound on authenticated requests one account may make per minute; 0 disables it.
# Every read writes an audit row, so this is what stops one credential from
# amplifying load on PostgreSQL and the Elastic pipeline.
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=600
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
# Rotating the key does not require downtime or a migration. Put the new key in
# ENCRYPTION_KEY, keep the old one(s) here (comma-separated), recreate the API
# containers (`make restart`: a plain restart keeps the old environment), then
# re-encrypt what the old key wrote and confirm before dropping it:
#
#   docker compose exec backend python -m scripts.rotate_keys rewrap
#   docker compose exec backend python -m scripts.rotate_keys status
#
# `status` is what tells you the old key is no longer needed. Leave empty when
# not rotating. See docs/upgrading.md, "Rotating secrets".
ENCRYPTION_PREVIOUS_KEYS=
# The label an authenticator app shows next to the account (the `issuer` in the
# otpauth:// URI). Set it when you run more than one deployment, so the entries
# are distinguishable rather than two identical-looking code generators.
MFA_ISSUER=OpenDRP
# Make the second factor a gate rather than a feature: with `true`, an
# administrator without an enrolled authenticator is refused every admin route
# (each refusal is audited as `auth.mfa.required`). `/auth/mfa/*` stays reachable
# so the administrator can enrol, and `manage_admin.py mfa-reset` remains the
# recovery path for a lost phone. Default `false`: an installation must not be
# able to lock its own administrator out.
REQUIRE_MFA_FOR_ADMINS=false
# The same policy, stated as the roles it applies to: a comma-separated list of
# `admin`, `analyst`, `viewer`. Both settings are read together — the roles listed
# here, plus `admin` whenever the flag above is `true` — so turning the list on
# never silently disables the flag an installation already relies on. An account
# whose role is listed and that has no enrolled authenticator is held at the
# onboarding step (refused everywhere but `/auth/mfa/*`, audited as
# `auth.mfa.required`). An unknown role name is a startup failure rather than a
# policy that quietly requires nothing. Empty by default.
REQUIRE_MFA_ROLES=
# The same idea for the JWT signing secret. Rotating JWT_SECRET_KEY would
# otherwise sign every user out, refresh tokens included; a secret listed here is
# still accepted for verification, so sessions survive the rotation. Remove it
# once JWT_REFRESH_TOKEN_EXPIRE_DAYS have passed.
JWT_PREVIOUS_SECRET_KEYS=
# Key for the audit hash chain: every audit entry carries an HMAC over its own
# fields and the previous entry's hash, so an edit, a deletion or an insertion in
# the trail is detectable (`make verify-audit-chain`, and the nightly task).
#
# Required in production — a key derived from another secret would stop verifying
# the moment that secret was rotated, which reads exactly like tampering.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# To rotate: put the new key here and the old one in AUDIT_CHAIN_PREVIOUS_KEYS
# (newest first). Old entries keep verifying; new ones are signed with the first.
AUDIT_CHAIN_KEYS=REPLACE_WITH_A_GENERATED_AUDIT_CHAIN_KEY
AUDIT_CHAIN_PREVIOUS_KEYS=

# CORS origins — JSON array or comma-separated list. This is the origin the
# browser uses, which is the TLS terminator in front of the installation and not
# the `FRONTEND_PORT` binding below: a browser opens https://drp.example.com and
# the proxy forwards to this host's UI port. Both halves must be written down
# consistently or a cross-origin request is refused with an error that names
# neither. For the check-on-this-machine shape the origin is
# `http://localhost:<FRONTEND_PORT port>`.
CORS_ORIGINS=["https://REPLACE_WITH_PUBLIC_HOST"]

# --- Networking ----------------------------------------------------------------
# Optional DNS overrides for backend, Celery and health probes. Leave the defaults
# unless the host requires an internal resolver. DNS_NAMESERVERS below is a
# separate resolver override shared by DNSTwist and the DNS Security resolver.
OPENDRP_DNS_PRIMARY=8.8.8.8
OPENDRP_DNS_SECONDARY=1.1.1.1
BACKEND_PORT=127.0.0.1:8000
# Published on loopback, like the API: the UI is reached through the TLS
# terminator in front of it. A bare port (`3000`) also publishes it on every
# interface, which puts a plaintext copy of the platform next to the encrypted
# one.
FRONTEND_PORT=127.0.0.1:3000
# Leave empty. Setting it makes the SPA send a browser that reached the UI under
# any *other* origin to this one, keeping the path and the query — useful only
# when the same UI is deliberately reachable under two origins. An installation
# has one (the `CORS_ORIGINS` origin above), so a value here is a redirect
# somewhere else: a development build once carried `http://localhost:3000`,
# which sent every real visitor to their own machine. It is compiled into the
# frontend bundle, so changing it needs `docker compose up -d --build frontend`.
CANONICAL_ORIGIN=
# Addresses whose forwarded headers may be believed. The backend resolves the
# real client IP itself, walking X-Forwarded-For from the right, so this must
# list every proxy in front of it. Compose appends OPENDRP_EDGE_SUBNET
# automatically, so set here only any *additional* proxy ranges (for example a
# TLS terminator in front of nginx).
#
# Only the edge is named, never the parent range and never the data or connector
# networks: a trusted network may write its own X-Forwarded-For entry into the
# audit trail, and the connector network holds code this platform did not write.
# The application refuses to start when a range here covers either of them.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Deliberately left at loopback: the application owns client-IP resolution, and
# letting uvicorn rewrite request.client from the (client-controlled) leftmost
# X-Forwarded-For entry would undo that.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# Address space for the three bridge networks. OPENDRP_NETWORK_SUBNET is the
# parent range; the other three are the networks themselves and must lie inside
# it (the application refuses to start otherwise, because audit rows would then
# record nginx's address instead of the client's). OPENDRP_EDGE_SUBNET is the
# range TRUSTED_PROXY_IPS names, and the one nginx must stay inside.
#
#   edge        frontend ↔ backend
#   data        backend, workers, PostgreSQL, Redis
#   connectors  backend ↔ connector containers (a plugin cannot reach a
#               datastore, no matter what it does with the token it was given)
OPENDRP_NETWORK_SUBNET=172.18.0.0/16
OPENDRP_EDGE_SUBNET=172.18.10.0/24
OPENDRP_DATA_SUBNET=172.18.20.0/24
OPENDRP_CONNECTOR_SUBNET=172.18.30.0/24

# --- TLS and HSTS ---------------------------------------------------------------
# Nothing in this stack terminates TLS. The UI is served as plain HTTP on
# loopback, and the terminator in front of the host (nginx, a load balancer, a
# cluster ingress) is what makes it https://. See docs/deployment.md and the
# nginx configuration shipped as docker/nginx/reverse-proxy.example.conf.
#
# HSTS tells a browser that this host is HTTPS-only, and the browser *remembers*
# that for HSTS_MAX_AGE seconds. It cannot be withdrawn early: the browser has to
# be reached over HTTPS with max-age=0, which is exactly what is unavailable when
# a certificate has expired or been replaced. That is why the default is off — an
# internal installation with a self-signed certificate would otherwise become
# unreachable for every browser that had already seen the header, and a
# certificate is replaced more often than HSTS_MAX_AGE passes.
#
# Both the API and the UI read these three settings, so the header cannot
# disagree with itself depending on which one answered the request.
HSTS_ENABLED=false
# One year: the value preload lists require. Lower it for a pilot.
HSTS_MAX_AGE=31536000
# Also applies the header to every subdomain of the host. Leave it off when the
# installation shares a parent domain with anything that is not HTTPS-only.
HSTS_INCLUDE_SUBDOMAINS=false

# --- Outbound destination policy -------------------------------------------------
# Where the platform may connect when an *operator* names the destination: the
# SMTP server for alert email, and the WHOIS lookup for a domain found in a
# finding. Loopback (127.0.0.0/8, ::1), link-local incl. the cloud metadata
# endpoint (169.254.0.0/16, plus Alibaba's 100.100.100.200 and Oracle's
# 192.0.0.192), multicast, and this deployment's own networks are refused by
# default — an "SMTP host" that is really the API, PostgreSQL or the instance
# metadata service is a way to use the platform against itself. Ordinary private
# ranges (10.x, 192.168.x) stay usable, because that is where an internal mail
# relay usually is.
#
# Add exceptions here, comma-separated, as hostnames or CIDRs:
#   OUTBOUND_ALLOWED_HOSTS=mail.internal.example,192.168.5.0/24
OUTBOUND_ALLOWED_HOSTS=
# Extra ranges to refuse, on top of the built-in list. Additive only.
OUTBOUND_BLOCKED_CIDRS=

# --- Database -------------------------------------------------------------------
# Connection pool. Bounded on purpose; see the statement limits below for the
# reason a single slow query is a platform-wide problem rather than a local one.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_USE_LIFO=true

# Statement limits. The connection pool is bounded, so one unbounded query does
# not slow a single request down — it removes a connection from everyone else
# until it finishes. PostgreSQL enforces these per connection; 0 disables the
# bound. Raise DB_STATEMENT_TIMEOUT_MS for a large inventory (report aggregation
# is the statement that needs the most headroom) rather than removing it.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Client-side bound on one round trip, deliberately above the server-side
# statement timeout so that Postgres is the one to cancel a slow statement.
DB_COMMAND_TIMEOUT_SECONDS=45

# Limits the schema migration runs under, which are deliberately not the two
# above: the migration is the one process that changes the schema while the
# platform is still serving, so an ALTER TABLE waiting behind an open
# transaction is its characteristic failure. Without a bound that wait is
# invisible — the API container is simply "unhealthy" while the startup migration
# blocks, and nothing in the log names the lock. 0 waits forever.
#
# MIGRATION_STATEMENT_TIMEOUT_MS is 0 on purpose and usually should stay there:
# the baseline builds its index families inside one transaction, and on a
# populated database that build is legitimately the longest statement this
# platform runs (see docs/upgrading.md, "the baseline's index families take a
# write lock"). Bound it only if your maintenance window has a hard ceiling.
MIGRATION_LOCK_TIMEOUT_MS=30000
MIGRATION_STATEMENT_TIMEOUT_MS=0

# --- Provider pacing -------------------------------------------------------------
# Shodan query credits and request limits vary by plan. The connector sends
# requests sequentially and waits at least this many seconds between them. A
# conservative default avoids bursts when Rescan runs all capabilities together.
# Read by both Shodan workers (phishing-shodan and the DNS dns-shodan).
SHODAN_MIN_REQUEST_INTERVAL_SECONDS=1
# Timeout for one Shodan API request. This is not the whole job timeout; it only
# bounds one provider round trip. The connector retries transient timeouts twice.
SHODAN_REQUEST_TIMEOUT_SECONDS=30

# --- Data retention --------------------------------------------------------------
# Swept nightly by the purge_expired_data beat task at 04:15 UTC. These bound the
# *database* copy of the audit trail and the generated PDFs in reports_store.
# What reaches the log pipeline (Elastic, Vector, ...) is kept by the collector
# and is governed by its own policy, not by these values.
#
# 0 disables the sweep for that kind of data and keeps it forever. That is the
# honest setting for an archive, but it is also the one that eventually fills
# the volume: the audit trail receives a row per authenticated read, so it
# grows with usage rather than with the size of the inventory.
AUDIT_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=365

# Certificate evidence from the DNS & TLS module: an identity or a place it was
# observed is kept for this long after it was last seen, an identity with no
# sighting left is removed, and a certificate scope exception past its own expiry
# date is deleted. 0 disables the sweep and keeps the evidence forever.
TLS_CERTIFICATE_RETENTION_DAYS=365

# Deletion is batched so one run never holds a long transaction. The batch cap
# bounds how long the sweep may occupy the (single-process) worker; a first run
# against a long backlog reports `truncated: true` in its audit entry and
# continues on the following night. Raise the cap for a one-off cleanup.
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES_PER_RUN=200

# --- Connector credentials -------------------------------------------------------
# There is no platform-wide connector secret. Each connector authenticates with
# its own token, issued (and stored only as a digest) by the core:
#   docker compose exec -T backend python -m scripts.manage_connector_tokens issue phishing-dnstwist --type phishing --env CONNECTOR_TOKEN_DNSTWIST
# then paste the printed value here and recreate that container
# (`docker compose up -d connector-phishing-dnstwist`). A restart is not enough: a
# container keeps the environment it was created with, so 'docker compose
# restart' would leave the placeholder in place. Where 'make' is available,
# 'make connector-token NAME=phishing-dnstwist TYPE=phishing' issues the token
# and updates this file in place; 'make connector-token-rotate NAME=...'
# replaces a value (the old token stops working immediately), and
# 'make connector-tokens' lists which connectors have a credential at all.
#
# Leaving these blank is safe: compose still runs, the connector refuses to start
# with a clear message, and the core rejects any token it did not issue. The
# placeholders below are what a hand-copied .env starts with, which has the same
# effect as blank — the connector never reaches the core with a real credential.
CONNECTOR_TOKEN_DNSTWIST=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_SHODAN=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_HIBP=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
# DNS worker credentials are per-source and optional. Provision each worker with
# its own module token (`--type dns`) before starting it. The keyless DNS workers
# start with the installation; VirusTotal and the Shodan certificate workers are
# opt-in behind their Compose profiles.
CONNECTOR_TOKEN_DNS_RDAP=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_DNS_RESOLVER=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_DNS_CTLOGS=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_DNS_VIRUSTOTAL=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_DNS_TLSPROBE=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_TOKEN_DNS_SHODAN=REPLACE_WITH_TOKEN_FROM_MANAGE_CONNECTOR_TOKENS
CONNECTOR_HEALTH_STALE_AFTER_SECONDS=120
# A running connector renews this lease while a scan is active. Expired jobs are
# retried up to this count, then marked as error.
CONNECTOR_JOB_LEASE_SECONDS=180
CONNECTOR_JOB_MAX_ATTEMPTS=3
ALERT_HEALTH_CHECK_TIMEOUT_SECONDS=15
# How long one channel's probe result is reused. Every miss dials SMTP or
# Telegram for real, from a pool of four probe slots, so two operators refreshing
# the dashboard used to mean two handshakes each. 0 probes on every request.
ALERT_HEALTH_CACHE_SECONDS=60
# One wall-clock timeout for each SMTP/Telegram delivery attempt.
ALERT_DELIVERY_TIMEOUT_SECONDS=20
# Retry only transient provider/network failures; permanent 4xx/configuration errors are not retried.
ALERT_DELIVERY_MAX_ATTEMPTS=3
ALERT_DELIVERY_RETRY_BASE_SECONDS=2
# How long a recipient stays held after a delivery whose outcome nobody knows —
# a worker died mid-send, or an SMTP thread timed out after the provider may
# already have accepted the message. Retrying at once could duplicate the
# notification; holding forever would silence that recipient for good, so the
# hold ends on this timer. An operator can end it early, once they have
# reconciled the ambiguity, from the alerts view.
ALERT_RECIPIENT_HOLD_SECONDS=900
# Findings are held briefly and grouped by completed connector job.
ALERT_AGGREGATION_DELAY_SECONDS=10
# How loudly a phishing candidate's confidence score is reported. At or above the
# direct threshold the candidate is alerted as soon as its signals are known;
# between the two it waits for the daily digest; below the digest threshold it is
# listed without a message, which is where most lookalikes belong. The digest
# threshold must stay below the direct one — an equal pair leaves no middle band at
# all and is refused at startup.
ALERT_CONFIDENCE_DIRECT=60
ALERT_CONFIDENCE_DIGEST=30
# The middle band is reported once a day instead of per scan. Turn this off to make
# the budget binary: only candidates at or above ALERT_CONFIDENCE_DIRECT are then
# ever delivered, and everything below is visible in the list alone.
ALERT_PHISHING_DIGEST_ENABLED=true
# UTC hour the digest runs at. 06:15 is after the default scan slots (02:30 and
# 03:30) so one message carries the night's candidates.
ALERT_PHISHING_DIGEST_HOUR_UTC=6
ALERT_MAX_FINDINGS_PER_MESSAGE=50
# How long a finding that no configured channel can receive is held before the
# outbox tries it again. It is held and not dropped: an installation whose SMTP
# is configured a day after the scan still hears about what the scan found, and
# the save that configures a channel reports the backlog as one message. 0 holds
# nothing — a notification no channel can receive is consumed where it stands,
# which is what the platform did before this window existed.
ALERT_NO_CHANNEL_RETRY_HOURS=24
# A candidate is reported when it is first seen. Whether a *revision* of one already
# reported is a second message is a deployment's choice: on, the channel says so when
# the candidate moves address, publishes new ports or is re-attributed to another
# brand; off, the change is still stored and visible in the list, and only the message
# is withheld. Every value in this block except the two ceilings
# (ALERT_MAX_FINDINGS_PER_MESSAGE, ALERT_MAX_TELEGRAM_MESSAGE_LENGTH) is also editable
# per installation in Settings → Alert budget, where a field left blank keeps answering
# from here.
ALERT_CANDIDATE_CHANGE_NOTIFICATIONS=true
# Credential breaches are the one module whose source classifies its own incidents,
# and two of those classes are not evidence that a credential leaked: the provider
# itself labels them. `store_only_spam` (the default) keeps the row — it stays
# visible in the list, with its flag — and sends no message; `verified_only` also
# silences an incident the source has not confirmed; `all` reports everything, which
# is what the platform did before this decision existed. Silence always needs a
# positive flag to act on, so an incident whose flags never arrived is reported.
ALERT_BREACH_NOISE_POLICY=store_only_spam
# A scan that finds a hundred new breach incidents is a backlog, not a report. Past
# this many new incidents in one scan, that scan's notifications wait for the daily
# digest instead of arriving as separate messages (the hour is the one above, so an
# installation has a single summary hour). 0 restores one message per scan.
ALERT_BREACH_DIGEST_THRESHOLD=20
# An incident the platform has already reported is reported again only when it says
# something new: the classes of data grew, it came back after being resolved, the
# source confirmed it, or the number of affected accounts rose by at least this much.
# The floor keeps a source's own bookkeeping edits — a correction of three accounts
# out of ten million — out of the channel.
ALERT_BREACH_GROWTH_FLOOR=1
# Leave headroom below Telegram's 4096-character limit — Telegram rejects a
# longer message with `400`, which the queue can only record as a permanent
# failure. A batch that does not fit is cut between findings rather than inside
# its own markup, and the message ends by saying how many findings it left out.
ALERT_MAX_TELEGRAM_MESSAGE_LENGTH=3800
# Maximum time spent resolving an SMTP/WHOIS destination. Synchronous libc DNS
# calls are executed off the event loop and abandoned after this deadline.
OUTBOUND_DNS_TIMEOUT_SECONDS=3
# Maximum rows included in one report and maximum wall-clock time for PDF render.
# Raise only after checking the worker memory limit and database statement budget.
REPORT_MAX_ROWS=5000
REPORT_GENERATION_TIMEOUT_SECONDS=120

# --- Metrics ---------------------------------------------------------------------
# Scrape token for `GET /api/v1/metrics`, presented as `X-Metrics-Token`. The
# endpoint answers Prometheus text exposition format; `docs/observability.md`
# lists every metric, the thresholds worth alerting on and a scrape config.
#
# Empty — the default — means the endpoint does not exist: it answers 404, so an
# installation that does not scrape anything publishes nothing about its backlog,
# its connectors or how far its audit chain has been verified. Set a random value
# to enable scraping; it is a shared credential, so production refuses one under
# 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# Maximum pending/generating reports across the installation; admission is serialized in PostgreSQL.
REPORT_QUEUE_MAX_PENDING=100
REPORT_ENQUEUE_MAX_RETRIES=2
REPORT_WORKER_CONCURRENCY=2

# These credentials are passed only to their matching connector containers by
# docker-compose; they are not application settings and are never stored in
# system_settings.
#
# Shodan: the connector's `ssl:"…"` and `http.favicon.hash` searches use query
# filters that Shodan does not serve on every plan. Full coverage needs a key of
# at least the Membership tier; on a lower tier the provider's refusal is
# reported in the job summary as a partial scan rather than as a clean result,
# and `scan_http_title` is the capability that works. The DNS Shodan worker
# (dns-shodan, `shodan` profile) reads this same key as its fallback; the key an
# operator stores on the approved source account takes precedence there.
SHODAN_API_KEY=REPLACE_WITH_SHODAN_API_KEY
# HIBP: for a test installation, HIBP's own integration key returns the
# documented fixture breaches and needs no subscription. Set it and add the two
# fixture assets below, and a breaches scan has something to find.
#   HIBP_API_KEY=00000000000000000000000000000000
#   email_account  account-exists@hibp-integration-tests.com
#   domain         hibp-integration-tests.com
# It is a test identity, not a secret: it only ever returns fixture data, and
# real results need a real key.
HIBP_API_KEY=REPLACE_WITH_HIBP_API_KEY

# The keyless DNS workers (RDAP, resolver, CT logs, TLS probe) are part of the base
# installation; VirusTotal and the Shodan confirmation worker are opt-in behind
# their own Compose profiles (`virustotal`, `shodan` — the latter shared with the
# phishing Shodan worker).
# Provision only the desired sources; this starts the keyless workers alone:
#   docker compose -f docker-compose.yml up -d --build --wait connector-dns-rdap connector-dns-resolver connector-dns-ctlogs connector-dns-tlsprobe
# Full provisioning/rotation/verification: docs/dns-security.md
# Starting every DNS worker at once can also claim old pending jobs.
# Issue an individual connector token with the normal CLI, e.g.
#   docker compose exec -T backend python -m scripts.manage_connector_tokens issue dns-rdap --type dns --env CONNECTOR_TOKEN_DNS_RDAP
# Connector-name/token mapping: dns-rdap→CONNECTOR_TOKEN_DNS_RDAP,
# dns-resolver→CONNECTOR_TOKEN_DNS_RESOLVER,
# dns-ctlogs→CONNECTOR_TOKEN_DNS_CTLOGS,
# dns-virustotal→CONNECTOR_TOKEN_DNS_VIRUSTOTAL,
# dns-tlsprobe→CONNECTOR_TOKEN_DNS_TLSPROBE,
# dns-shodan→CONNECTOR_TOKEN_DNS_SHODAN.
# The resolver asks for A/AAAA/CNAME by default. Set extended=true to include
# NS/MX/CAA, and keep its timeout bounded.
# Core expiry checks refuse evidence older than this many hours.
DNS_EXPIRY_MAX_AGE_HOURS=48
DNS_SECURITY_RESOLVER_TIMEOUT_SECONDS=3
DNS_SECURITY_RESOLVER_EXTENDED=false
DNS_SECURITY_CTLOGS_API_BASE=https://api.ctlogs.dev
# Optional provider credential (Authorization: Bearer); distinct from the core worker token.
DNS_SECURITY_CTLOGS_API_TOKEN=
# The keyless tier of this API is restricted to non-commercial use, and the paid
# plan is what the token above buys. Exactly one of the two is required: without a
# token the worker refuses every request until this acknowledgement is true, the
# same way the VirusTotal worker does.
DNS_SECURITY_CTLOGS_PUBLIC_NONCOMMERCIAL=false
# The keyless tier allows 100 requests per hour with one request in flight, which is
# where these defaults come from. A keyed plan raises both ceilings. Only a bounded
# number of domains fits in one scan's budget, so the worker starts each scan where
# the previous one stopped; leave the numbers alone unless the tier changed.
DNS_SECURITY_CTLOGS_MAX_REQUESTS_PER_SCAN=100
DNS_SECURITY_CTLOGS_MIN_REQUEST_INTERVAL_SECONDS=36
# The active TLS probe asks our own services what certificate they serve, so the
# expiry monitor stops depending on what a log happened to index. It performs one
# bounded handshake per host and port: no provider is involved and no other host is
# ever contacted. TLS_PORTS is an allowlist of at most three ports, TLS_PATH is what
# it requests, and TLS_MAX_PROBES bounds the handshakes in a single scan.
DNS_SECURITY_TLS_PORTS=443
DNS_SECURITY_TLS_PATH=/
DNS_SECURITY_TLS_MAX_PROBES=200
# VirusTotal public API keys are personal/non-commercial only; never enable for
# business use. The connector refuses to send a request without this explicit
# personal-use acknowledgement, even when an API key is present. Redis windows carry
# the provider budget the operator approved for the account and count every request
# attempt, including retries; one scan is additionally capped at 500 requests.
DNS_SECURITY_VT_API_KEY=
DNS_SECURITY_VT_PUBLIC_NONCOMMERCIAL=false

# Shodan capability fallbacks. These apply only until an administrator changes
# the capability in the connector's configuration form under Settings — the
# registry value takes precedence for every later scan.
#
# Namespaced like every other connector-scoped setting (`SHODAN_API_KEY`,
# `SHODAN_MIN_REQUEST_INTERVAL_SECONDS`): `.env` is one namespace shared by every
# service in the Compose file set, so a bare `SCAN_*` would collide the moment a
# second connector wanted the same word.
SHODAN_SCAN_SSL_TEXT=true
SHODAN_SCAN_HTTP_TITLE=true
SHODAN_SCAN_FAVICON=true

# The five questions added by the Shodan budget-and-filters wave default to *off*,
# unlike the three above. Each spends query credits on a vendor field name, and
# Shodan bills by search and by result page; the two that depend on a field name
# nobody has confirmed against this account (`ssl.cert.subject.cn` and the
# organisation variant the filter reference does not list) are confirmed first by
# `connectors/shodan/live_check.py`. `SHODAN_SCAN_HOST_LOOKUP` is the free
# `/shodan/host/{ip}` enrichment: the vendor's API guide bills no query credit for
# an IP lookup, and it is off with the rest only because which fields *this*
# account answers with is what the same spike answers.
SHODAN_SCAN_HTTP_BODY=false
SHODAN_SCAN_CERT_SUBJECT=false
SHODAN_SCAN_HTML_HASH=false
SHODAN_SCAN_PIVOTS=false
SHODAN_SCAN_HOST_LOOKUP=false

# Those five questions also wait for an explicit statement that the plan permits
# them (F-12). A switch is not a confirmation: without this the worker refuses
# them by name (`licence_acknowledgement_required`) instead of spending silently.
SHODAN_TERMS_ACKNOWLEDGED=false

# ==============================================================================
# Values Compose builds for you
# ==============================================================================
# Setting either of these in .env has no effect on a Compose deployment: every
# service is handed a URL Compose constructs, so that the URL cannot drift from
# the password the datastore was started with. They are documented because the
# application reads them, and a deployment running the API outside Compose sets
# them itself.
#
# DATABASE_URL=postgresql+asyncpg://opendrp:${POSTGRES_PASSWORD}@postgres:5432/opendrp
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==============================================================================
# Advanced overrides
# ==============================================================================
# Nothing here has to be set for a working deployment. Each line shows the value
# Compose applies when the variable is absent; uncomment only what you change.
# `python setup.py --check` will not ask you about any of them.
#
# How many Uvicorn worker processes the API container runs. One is right for a
# small installation; raise it only when the API is CPU-bound and the connection
# pool is large enough for every worker (each process opens its own pool).
# UVICORN_WORKERS=1
#
# Optional resolver IPs for DNSTwist and the DNS Security resolver worker. Leave
# empty to use the Docker/system resolver; set up to eight comma-separated IPs.
# DNS_NAMESERVERS=
# Which DNSTwist techniques a scan asks for, as comma-separated classes rather than as
# a raw fuzzer list: a class brings the technique *and* the dictionary it needs (the
# CLI refuses `--tld`/`--dictionary` unless their fuzzer is in the same command, which
# a raw list cannot express). Known classes: typo, idn, bitsquatting, plural,
# subdomain, dictionary, various, tld. Default: typo. The expensive ones
# (idn, subdomain, dictionary, tld) are opt-in: together they can generate thousands of
# DNS requests for one asset.
# DNSTWIST_FUZZER_CLASSES=typo
# Optional TLD dictionary (used by the `tld` class). Empty means the packaged
# /usr/share/dnstwist/dictionaries/common_tlds.dict, or a named skip when the image
# does not have it.
# DNSTWIST_TLD_DICTIONARY=
# Optional word list (used by the `dictionary` class). Empty means the packaged
# /usr/share/dnstwist/dictionaries/english.dict.
# DNSTWIST_DICTIONARY=
# How many permutations one domain may ask about (1-5000, default 250). The CLI has no
# such option, so the bound is applied where it costs nothing: a permutation that is
# never resolved is never submitted and spends no DNS request. A shortened candidate
# set is reported (`domains_truncated`).
# DNSTWIST_MAX_CANDIDATES=250
# Pass the CLI's `--mxcheck` and ask the candidate's TXT records for an SPF policy, so
# `mx_without_spf` is reported from an answer the platform has. Off by default: it
# costs no provider credits but does connect to the candidate's mail server over SMTP.
# DNSTWIST_MX_CHECK=false
# Pass `--lsh tlsh` (page similarity against our own page). Requires the TLSh module in
# the connector image; without it the capability is reported as unavailable rather than
# run. `--phash` and screenshots are deliberately never used.
# DNSTWIST_CONTENT_INSPECTION=false
# Maximum seconds for one dnstwist subprocess. A timeout is recorded as a partial
# job and the complete process group is terminated.
# DNSTWIST_TIMEOUT_SECONDS=120
# Maximum concurrent dnstwist threads (1-32).
# DNSTWIST_THREADS=8
#
# Image registry prefix, for a fork or a private mirror.
# OPENDRP_IMAGE_PREFIX=ghcr.io/opendrp/opendrp
#
# uid/gid the backend image runs as. On Linux a bind mount keeps the host's
# ownership, so a developer whose uid is not 1000 sets these or the dev overlay's
# source mount is not writable and the coverage targets fail.
# OPENDRP_UID=1000
# OPENDRP_GID=1000
#
# Backup profile (`make backup` / the `backup` service): how many dumps to keep,
# how often the scheduled pass runs, and how stale the newest dump may be before
# the service is reported unhealthy. See docs/backup-restore.md.
# BACKUP_KEEP=14
# BACKUP_INTERVAL_SEC=86400
# BACKUP_MAX_AGE_MIN=1560
#
# Ports for the optional MailHog service. It is commented out in the base
# Compose file; uncomment that block to run a local SMTP sink for debugging
# alert email.
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
#
# Credentials for an existing administrator, read by `make verify-replicas`
# (docker-compose.replicas.yml) to log in against the two-replica stack. They are
# not application settings and are never stored.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Keyed connectors (docker-compose.yml) --------------------------------------
# Keyed workers are described in docker-compose.yml but start only when their
# profile is enabled, e.g. COMPOSE_PROFILES=netlas,shodan,hibp,virustotal.
# Keyless workers (dnstwist, DNS RDAP/resolver/CT logs) start with the installation.
# Netlas is the only passive-intelligence provider; its key never goes to the
# browser.
NETLAS_API_TOKEN=
# Netlas `http.body` searches are the broadest question the phishing worker asks.
# Confirm in the account that the plan permits them; unset means the question is
# refused and reported, not silently skipped (F-12).
INTELLIGENCE_HTTP_BODY_ACKNOWLEDGED=false
CONNECTOR_TOKEN_NETLAS_PHISHING=
CONNECTOR_TOKEN_NETLAS_DNS_SECURITY=
CONNECTOR_TOKEN_NETLAS_EXPOSURE=
CONNECTOR_TOKEN_EXPOSURE_NETLAS_ENDPOINTS=
CONNECTOR_TOKEN_EXPOSURE_SHODAN_ENDPOINTS=

# --- Alert integrations ----------------------------------------------------------
# SMTP and Telegram settings are configured in the administrator UI and stored
# encrypted with ENCRYPTION_KEY. Do not put those secrets in this file.
